# ---------------------------------------------------------------------------
# Pramansetu — environment configuration
# Copy to apps/api/.env and apps/web/.env as needed.
# ---------------------------------------------------------------------------

# ---- API (apps/api/.env) ----
NODE_ENV=development
PORT=4000
APP_ORIGIN=http://localhost:5173

# MongoDB Atlas connection string. Leave blank to use the local file-backed
# store (apps/api/.data/db.json) for development and testing.
MONGODB_URI=

# Secrets — generate with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
ACCESS_TOKEN_TTL=15m
REFRESH_TOKEN_DAYS=30

# OTP — console | msg91 | twilio (console prints the code in dev only)
OTP_PROVIDER=console
OTP_EXPOSE_DEV_CODE=true
OTP_TTL_MINUTES=10
OTP_MAX_ATTEMPTS=5

# Optional SMS / email provider credentials
MSG91_AUTH_KEY=
MSG91_SENDER_ID=
MSG91_TEMPLATE_ID=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
RESEND_API_KEY=
MAIL_FROM=no-reply@pramansetu.app

# Comma-separated allowlist. localhost origins are always allowed in dev.
CORS_ORIGINS=http://localhost:5173,https://pramansetu.vercel.app

# Feature flags
AI_EXPLANATIONS=false
ANTHROPIC_API_KEY=
ENABLE_DEMO_LOGIN=true
SEED_DEMO=true

# Demo accounts (seed)
SEED_ADMIN_PHONE=9999999999
SEED_DEMO_PHONE=9876543210

# ---- Web (apps/web/.env) ----
VITE_API_URL=http://localhost:4000
