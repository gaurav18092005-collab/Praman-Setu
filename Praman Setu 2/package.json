{
  "name": "pramansetu",
  "version": "1.0.0",
  "private": true,
  "description": "Pramansetu — know what you can claim, carry what you need.",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "concurrently -n api,web -c blue,green \"npm:dev:api\" \"npm:dev:web\"",
    "dev:api": "npm run dev -w @pramansetu/api",
    "dev:web": "npm run dev -w @pramansetu/web",
    "e2e:api": "npm run e2e -w @pramansetu/api",
    "build": "npm run build -w @pramansetu/shared && npm run build -w @pramansetu/api && npm run build -w @pramansetu/web",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:e2e": "npm run test:e2e -w @pramansetu/web",
    "seed": "npm run seed -w @pramansetu/api",
    "lint": "eslint apps packages --ext .ts,.tsx",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^8.19.0",
    "@typescript-eslint/parser": "^8.19.0",
    "concurrently": "^9.1.2",
    "eslint": "^8.57.1",
    "eslint-plugin-react-hooks": "^5.1.0",
    "prettier": "^3.4.2",
    "sharp": "^0.35.5",
    "typescript": "^5.7.2"
  },
  "engines": {
    "node": ">=20"
  }
}
